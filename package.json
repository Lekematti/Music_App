{
  "name": "music_app",
  "version": "0.5.5",
  "description": "Alpha version of the music app",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "frontend/index.html",
  "prisma": {
    "schema": "backend/prisma/schema.prisma"
  },
  "scripts": {
    "dev": "concurrently \"npm run frontend\" \"npm run backend\"",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "frontend": "vite",
    "backend": "node backend/index.js",
    "coverage": "vitest run --coverage",
    "coverage:backend": "vitest run --coverage backend/tests",
    "coverage:frontend": "vitest run --coverage frontend/tests",
    "test:frontend": "vitest run frontend/tests",
    "test:backend": "vitest run backend/tests",
    "test:unit": "vitest run backend/tests/unit",
    "test:integration": "vitest run backend/tests/integration"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "25.7.0",
    "@vitest/coverage-v8": "^4.1.5",
    "concurrently": "9.2.1",
    "eslint": "^10.4.1",
    "eslint-plugin-jest": "^29.15.2",
    "globals": "^17.6.0",
    "jsdom": "29.1.1",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "supertest": "7.2.2",
    "vite": "8.0.15",
    "vitest": "4.1.9"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "7.8.0",
    "@supabase/supabase-js": "^2.106.1",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "multer": "^2.1.1",
    "resend": "^6.12.4"
  }
}
